<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  파이프라인 A (A0'~A7) 실행 — 설계서 §4.6. 주기: 월/목 09:00.

  설치 (이 Mac, 2026-09-05):
    cp launchd/com.talkinsight.collect_publish.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.talkinsight.collect_publish.plist
  해제:
    launchctl unload ~/Library/LaunchAgents/com.talkinsight.collect_publish.plist
  지금 바로 한 번 돌려보기:
    launchctl start com.talkinsight.collect_publish

  경로가 OneDrive 아래라 다른 Mac에서는 아래 절대경로 4곳을 바꿔야 한다.
  인터프리터는 .venv(google-genai, fonttools)를 쓴다 — 시스템 python3로 부르면 A4에서 멈춘다.
  Mac이 꺼져 있어 놓친 사이클은 다음 실행이 state.json의 last_report_until부터 이어받는다(C3).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.talkinsight.collect_publish</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/keemhayun/Library/CloudStorage/OneDrive-한국교원대학교/Claude Code/Notion/notion_talk_kakao/.venv/bin/python</string>
        <string>/Users/keemhayun/Library/CloudStorage/OneDrive-한국교원대학교/Claude Code/Notion/notion_talk_kakao/scripts/run_cycle.py</string>
        <string>--pipeline</string>
        <string>collect_publish</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/keemhayun/Library/CloudStorage/OneDrive-한국교원대학교/Claude Code/Notion/notion_talk_kakao</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>LANG</key>
        <string>ko_KR.UTF-8</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/keemhayun/Library/CloudStorage/OneDrive-한국교원대학교/Claude Code/Notion/notion_talk_kakao/output/logs/launchd_collect_publish.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/keemhayun/Library/CloudStorage/OneDrive-한국교원대학교/Claude Code/Notion/notion_talk_kakao/output/logs/launchd_collect_publish.err.log</string>
</dict>
</plist>
